// Health Helper - Prisma Schema
// 对应架构文档 ARCHITECTURE.md §4 数据模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================
// 用户与认证
// ===========================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String?   @map("display_name")
  heightCm      Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg      Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  birthDate     DateTime? @map("birth_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  exerciseRecords    ExerciseRecord[]
  dailySteps         DailyStep[]
  dietRecords        DietRecord[]
  moodRecords        MoodRecord[]
  chatLogs           ChatLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String    @map("device_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

// ===========================
// 运动
// ===========================

model ExerciseType {
  id              String  @id
  displayNameZh   String  @map("display_name_zh")
  displayNameEn   String  @map("display_name_en")
  met             Decimal @db.Decimal(4, 2)
  notes           String? @db.Text
  iconKey         String? @map("icon_key")

  records ExerciseRecord[]

  @@map("exercise_types")
}

model ExerciseRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  typeId       String   @map("type_id")
  startedAt    DateTime @map("started_at") @db.Timestamptz
  durationSec  Int      @map("duration_sec")
  distanceKm   Decimal? @map("distance_km") @db.Decimal(6, 2)
  calories     Decimal  @db.Decimal(7, 2)
  clientId     String?  @map("client_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type ExerciseType @relation(fields: [typeId], references: [id])

  @@unique([userId, clientId])
  @@index([userId, startedAt])
  @@map("exercise_records")
}

model DailyStep {
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  steps     Int
  source    String?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([userId, date])
  @@map("daily_steps")
}

// ===========================
// 饮食
// ===========================

model FoodNutrient {
  id             BigInt  @id @default(autoincrement())
  source         String
  externalId     String? @map("external_id")
  name           String
  nameZh         String? @map("name_zh")
  category       String?
  servingSizeG   Decimal? @map("serving_size_g") @db.Decimal(8, 2)
  kcalPer100g    Decimal? @map("kcal_per_100g") @db.Decimal(7, 2)
  proteinG       Decimal? @map("protein_g") @db.Decimal(6, 2)
  fatG           Decimal? @map("fat_g") @db.Decimal(6, 2)
  carbsG         Decimal? @map("carbs_g") @db.Decimal(6, 2)
  fiberG         Decimal? @map("fiber_g") @db.Decimal(6, 2)
  sodiumMg       Decimal? @map("sodium_mg") @db.Decimal(8, 2)
  extra          Json?

  records DietRecord[]

  @@index([source, externalId])
  @@index([name])
  @@map("food_nutrients")
}

model DietRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  foodId      BigInt   @map("food_id")
  mealType    String   @map("meal_type")
  consumedAt  DateTime @map("consumed_at") @db.Timestamptz
  servings    Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  food FoodNutrient @relation(fields: [foodId], references: [id])

  @@index([userId, consumedAt])
  @@map("diet_records")
}

// ===========================
// 心理健康
// ===========================

model MoodRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  mood       String
  score      Int?
  note       String?  @db.Text
  recordedAt DateTime @map("recorded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("mood_records")
}

model ChatLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_logs")
}
