# Health Helper API - Environment Variables
# Copy this file to .env and fill in real values

# === Server ===
NODE_ENV=development
PORT=3000

# === Database ===
DATABASE_URL=postgresql://health_helper:health_helper@localhost:5432/health_helper?schema=public

# === Auth ===
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=another-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# === CORS ===
# Comma-separated list of allowed origins for web clients
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# === AI Provider (for /api/chat) ===
# Leave empty to disable AI chat endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# === Logging ===
LOG_LEVEL=info
